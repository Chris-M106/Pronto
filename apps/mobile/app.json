{
  "expo": {
    "name": "Pronto",
    "slug": "pronto",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pronto",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "ios": {
      "bundleIdentifier": "com.pronto.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.pronto.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E2B5E"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pronto needs photo access to attach job photos."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "stripePublishableKey": ""
    }
  }
}
